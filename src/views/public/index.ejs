<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= alhaji.name %> - Official Booking</title>
<style>body{margin:0;font-family:system-ui;background:#0f0f0f;color:#fff} .hero{background:linear-gradient(rgba(0,0,0,.8),rgba(0,0,0,.8)),url('https://images.unsplash.com/photo-1514525253161-7a46d19cd819');background-size:cover;padding:50px 20px;text-align:center} .gold{color:#f5c518} .btn{background:#f5c518;color:#000;padding:14px 28px;border-radius:30px;text-decoration:none;font-weight:bold;display:inline-block;margin:6px} .btn2{border:1px solid #f5c518;color:#f5c518;background:transparent} .card{background:#1c1c1c;margin:15px;padding:20px;border-radius:12px;border-left:4px solid #f5c518} iframe{border-radius:12px;width:100%;max-width:600px} .wrap{max-width:800px;margin:auto}</style></head><body>
<div class="hero"><h1 class="gold"><%= alhaji.name %></h1><p><%= alhaji.tagline %></p><p>🇳🇬 Ibafo, Ogun | 🇺🇸 Available for US Tours</p><a class="btn" href="https://wa.me/<%= alhaji.phone %>?text=<%= encodeURIComponent(alhaji.whatsappMsg) %>">💬 WhatsApp Direct</a><a class="btn btn2" href="#packages">View Prices</a></div>
<div class="wrap" style="padding:20px">
<h3>🔥 Live in Maryland, USA (2023)</h3>
<iframe height="220" src="https://www.youtube.com/embed/<%= alhaji.youtubeId %>" frameborder="0" allowfullscreen></iframe>
<h2 id="packages" style="margin-top:30px">Booking Packages</h2>
<% packages.forEach(p=>{ %><div class="card"><span style="background:#f5c518;color:#000;padding:3px 10px;border-radius:10px;font-size:12px"><%= p.priceNote %></span><h3 style="margin:10px 0 5px"><%= p.name %></h3><h2 class="gold" style="margin:5px 0"><%= p.price %></h2><small><%= p.duration %></small><p style="color:#aaa"><%= p.description %></p><a class="btn" href="/book/<%= p._id %>">Book This Package</a></div><% }) %>
<div style="background:#1c1c1c;padding:20px;border-radius:12px;margin:20px 15px;text-align:center"><h3>Why Book Direct?</h3><p style="color:#aaa">✓ No middleman ✓ Direct WhatsApp ✓ US & Naira payment ✓ Official website</p></div>
</div><div style="text-align:center;padding:30px;background:#000;color:#555"><p><%= alhaji.name %> © 2026 | Ibafo, Ogun State</p><a href="/admin/bookings" style="color:#333">Admin</a></div></body></html>