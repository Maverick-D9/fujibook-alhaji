<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Book <%= package.name %></title><style>body{background:#0f0f0f;color:#fff;font-family:system-ui;padding:20px} input,textarea{width:100%;padding:14px;margin:8px 0;border-radius:8px;border:1px solid #333;background:#1c1c1c;color:#fff;box-sizing:border-box} .btn{background:#f5c518;color:#000;padding:14px;border:none;border-radius:30px;width:100%;font-weight:bold;font-size:16px} .card{background:#1c1c1c;padding:20px;border-radius:12px;max-width:500px;margin:auto}</style></head><body>
<div class="card"><a href="/" style="color:#f5c518">← Back</a><h2>Book: <%= package.name %></h2><h3 style="color:#f5c518"><%= package.price %> | <%= package.duration %></h3>
<form method="POST"><input name="customerName" placeholder="Your Full Name (US or Nigeria)" required><input name="phone" placeholder="WhatsApp Number (+1 or +234)" required><input type="date" name="date" required><input name="location" placeholder="Event Location (e.g Maryland, US or Ibafo)" required><input name="guests" placeholder="Number of Guests"><textarea name="message" placeholder="Tell Alhaji about your event"></textarea><button class="btn">Confirm Booking - Pay on Event Day</button></form></div></body></html>