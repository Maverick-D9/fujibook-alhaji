<!DOCTYPE html>
<html>
<head>
<title>Admin Login - <%= alhaji.shortName %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{background:#000;color:#fff;font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0}
.card{background:#111;border:1px solid #333;padding:32px;border-radius:16px;width:100%;max-width:360px;box-shadow:0 10px 30px rgba(0,0,0,.5)}
h2{color:#f5c518;margin:0 0 8px} p{color:#888;font-size:14px;margin:0 0 20px}
input{width:100%;padding:12px;background:#000;border:1px solid #333;color:#fff;border-radius:8px;margin:8px 0;box-sizing:border-box}
button{width:100%;padding:12px;background:#f5c518;color:#000;border:0;border-radius:8px;font-weight:700;margin-top:12px;cursor:pointer}
.error{background:#ff000020;border:1px solid #ff000050;color:#ff6b6b;padding:10px;border-radius:8px;font-size:13px;margin-bottom:12px}
a{color:#f5c518;text-decoration:none;font-size:13px}
</style>
</head>
<body>
<div class="card">
<h2>Admin Login</h2>
<p><%= alhaji.shortName %> Management</p>
<% if(error){ %><div class="error"><%= error %></div><% } %>
<form method="POST" action="/admin/login">
<input name="username" placeholder="Username (alhaji)" required>
<input name="password" type="password" placeholder="Password" required>
<button type="submit">Enter Admin</button>
</form>
<p style="margin-top:16px"><a href="/">← Back to website</a></p>
<p style="color:#555;font-size:11px;margin-top:8px">Demo: alhaji / fuji2026</p>
</div>
</body>
</html>