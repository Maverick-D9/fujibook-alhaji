<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{background:#111;color:#fff;font-family:system-ui;padding:20px} input,textarea{width:100%;padding:12px;margin:6px 0;border-radius:8px;border:1px solid #333;background:#1c1c1c;color:#fff;box-sizing:border-box} .btn{background:#f5c518;color:#000;padding:12px;border:none;border-radius:8px;font-weight:bold;cursor:pointer}</style></head><body><h2>Manage Packages - <%= alhaji.name %></h2><a href="/?pass=<%= pass %>" style="color:#f5c518">Home</a> | <a href="/admin/bookings?pass=<%= pass %>" style="color:#f5c518">Bookings</a>
<div style="margin-top:20px"><% packages.forEach(p=>{ %><div style="background:#1c1c1c;padding:15px;margin:10px 0;border-radius:8px;display:flex;justify-content:space-between;align-items:center"><div><b><%= p.name %></b> - <%= p.price %> (<%= p.duration %>)<br><small style="color:#888"><%= p.description %></small></div><form method="POST" style="margin:0"><input type="hidden" name="id" value="<%= p._id %>"><input type="hidden" name="action" value="delete"><button class="btn" style="background:#ff4444;color:#fff">Delete</button></form></div><% }) %></div>
<h3 style="margin-top:30px">Add New Package</h3><form method="POST"><input type="hidden" name="action" value="add"><input name="name" placeholder="Package Name (e.g US Wedding)" required><input name="price" placeholder="Price e.g $3,000 or ₦800,000" required><input name="priceNote" placeholder="Badge e.g Most Popular"><input name="duration" placeholder="Duration e.g 4 Hours" required><textarea name="description" placeholder="Description"></textarea><button class="btn">Add Package</button></form></body></html>