<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{background:#111;color:#fff;font-family:system-ui;padding:20px} table{width:100%;border-collapse:collapse;background:#1c1c1c;border-radius:10px;overflow:hidden} th,td{padding:12px;text-align:left;border-bottom:1px solid #333} th{color:#f5c518}</style></head><body><h2>All Bookings - <%= alhaji.shortName %></h2><a href="/" style="color:#f5c518">← Home</a> | <a href="/admin/packages" style="color:#f5c518">Packages</a><p>Total: <%= bookings.length %> bookings</p>
<table><tr><th>Name</th><th>Package</th><th>Phone</th><th>Date</th><th>Location</th><th>Action</th></tr>
<% bookings.forEach(b=>{ %><tr><td><%= b.customerName %></td><td><%= b.packageName %></td><td><a href="https://wa.me/<%= b.phone.replace(/[^0-9]/g,'') %>" style="color:#25D366"><%= b.phone %></a></td><td><%= b.date %></td><td><%= b.location %></td><td><a href="/admin/bookings/delete/<%= b._id %>" style="color:red">Delete</a></td></tr><% }) %>
</table><% if(bookings.length===0){ %><p style="color:#888;text-align:center;margin-top:30px">No bookings yet. Share your website link!</p><% } %></body></html>